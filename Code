                    }.themeGlassStyle().listRowBackground(Color.clear).listRowSeparator(.hidden).padding(.vertical, 10)

                    // Logs
                    if groupedLogs.isEmpty { Text("No logs yet.").foregroundColor(.secondary).listRowBackground(Color.clear) }
                    else {
                        ForEach(groupedLogs, id: \.0) { date, dailyLogs in
                            Section {
                                ForEach(dailyLogs) { log in
                                    HStack {
                                        Text(log.emoji).font(.title)
                                        VStack(alignment: .leading) {
                                            Text(log.title).font(.body).foregroundColor(.primary)
                                            if let custom = log.subtitle, !custom.isEmpty { Text(custom).font(.caption).foregroundColor(.secondary) }
