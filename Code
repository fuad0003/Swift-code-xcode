                            Image(systemName: isLoss ? "arrow.down.right.circle.fill" : "arrow.up.right.circle.fill").foregroundColor(isLoss ? (themeManager.currentTheme == .classicWhite ? .green : Color(red: 0.02, green: 0.84, blue: 0.63)) : .red)
