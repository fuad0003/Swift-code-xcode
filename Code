// MARK: - 5. MAIN DASHBOARD
struct DashboardView: View {
    @EnvironmentObject var themeManager: ThemeManager
    @ObservedObject var healthManager: HealthManager
    @Binding var isMenuOpen: Bool

    @State private var mealLogs: [MealLog] = []
    @State private var savedMealTemplates: [MealLog] = []

    @State private var showingAddMeal = false
    @State private var selectedViewingMonth: Date = Date()
    @State private var showingMonthPicker = false
    @State private var showingNotifications = false
    @State private var showingCalendarOverview = false
    @State private var showingIntakeDetails = false

    var validMonthLogs: [MealLog] {
        let calendar = Calendar.current
        return mealLogs.filter { log in calendar.isDate(log.date, equalTo: selectedViewingMonth, toGranularity: .month) && (log.isSavedTemplate == false || log.isSavedTemplate == nil) }
    }

    var validMonthWorkouts: [WorkoutLog] {
        let calendar = Calendar.current
        return healthManager.workoutLogs.filter { log in calendar.isDate(log.date, equalTo: selectedViewingMonth, toGranularity: .month) }
    }

    var monthlyCaloriesConsumed: Double { validMonthLogs.reduce(0) { $0 + $1.calories } }
    var monthlyWorkoutCalories: Double { validMonthWorkouts.reduce(0) { $0 + $1.caloriesBurned } }

    var monthlyCalorieTarget: Double {
        let mealDates = validMonthLogs.map { Calendar.current.startOfDay(for: $0.date) }
        let workoutDates = validMonthWorkouts.map { Calendar.current.startOfDay(for: $0.date) }
        return (healthManager.profile.baseDailyTargetCalories * Double(max(1, Set(mealDates + workoutDates).count))) + monthlyWorkoutCalories
    }
    var netCalorieBalance: Double { monthlyCaloriesConsumed - monthlyCalorieTarget }
    var estimatedKgChange: Double { netCalorieBalance / 7700.0 }

    var groupedLogs: [(Date, [DailyEntry])] {
        var combined: [DailyEntry] = validMonthLogs.map { DailyEntry(date: $0.date, isWorkout: false, title: $0.categoryItem.name, subtitle: $0.customName, calories: $0.calories, emoji: $0.categoryItem.emoji) }
        combined.append(contentsOf: validMonthWorkouts.map { DailyEntry(date: $0.date, isWorkout: true, title: $0.workoutType, subtitle: "HealthKit", calories: $0.caloriesBurned, emoji: "🔥") })

        let grouped = Dictionary(grouping: combined) { Calendar.current.startOfDay(for: $0.date) }
        return grouped.map { (date: $0.key, logs: $0.value.sorted { $0.date > $1.date }) }.sorted { $0.date > $1.date }
    }

    func formatDate(_ date: Date) -> String { let f = DateFormatter(); f.dateFormat = "E, MMM d, yyyy"; return f.string(from: date) }
    func formatMonthYear(_ date: Date) -> String { let f = DateFormatter(); f.dateFormat = "MMMM yyyy"; return f.string(from: date) }
    func deleteLog(id: UUID, isWorkout: Bool) { if isWorkout { healthManager.workoutLogs.removeAll { $0.id == id } } else { mealLogs.removeAll { $0.id == id } } }

    var body: some View {
        VStack(spacing: 0) {
            // Navbar
            HStack {
                Button(action: { withAnimation(.spring()) { isMenuOpen.toggle() } }) { Image(systemName: "line.3.horizontal").font(.title2).foregroundColor(.primary) }
                Spacer()
                Button(action: { showingMonthPicker = true }) {
                    HStack(spacing: 4) { Text(formatMonthYear(selectedViewingMonth)).font(.headline).foregroundColor(.primary); Image(systemName: "arrowtriangle.down.fill").font(.caption2).foregroundColor(.secondary) }
                }
                Spacer()

                Button(action: { healthManager.generateLocalWeeklyReport(from: mealLogs); showingNotifications = true }) {
                    Image(systemName: "doc.text.magnifyingglass").padding(.trailing, 10).foregroundColor(.primary)
                }

                Button(action: { showingNotifications = true }) {
                    ZStack(alignment: .topTrailing) {
                        Image(systemName: "bell").foregroundColor(.primary)
                        if !healthManager.notifications.isEmpty { Circle().fill(Color.red).frame(width: 8, height: 8).offset(x: 2, y: -2) }
                    }.padding(.trailing, 10)
                }
                Button(action: { showingCalendarOverview = true }) { Image(systemName: "calendar").foregroundColor(.primary) }
            }
            .padding().background(.ultraThinMaterial).background(themeManager.currentTheme == .muzliDark ? Color.black.opacity(0.4) : Color.clear).overlay(Rectangle().frame(height: 1).foregroundColor(Color.primary.opacity(0.1)), alignment: .bottom)

            ZStack(alignment: .bottom) {
                List {
                    // Dashboard Card
                    VStack(spacing: 0) {
                        HStack {
                            Button(action: { showingIntakeDetails = true }) { VStack(alignment: .leading) { Text("Intake").font(.subheadline).foregroundColor(.secondary); Text("\(monthlyCaloriesConsumed, specifier: "%.0f")").font(.title3).bold().foregroundColor(.primary) } }.buttonStyle(PlainButtonStyle())
                            Spacer(); VStack(alignment: .center) { Text("Burned").font(.subheadline).foregroundColor(.secondary); Text("\(monthlyWorkoutCalories, specifier: "%.0f")").font(.title3).bold().foregroundColor(.primary) }
                            Spacer(); VStack(alignment: .trailing) { Text("Target").font(.subheadline).foregroundColor(.secondary); Text("\(monthlyCalorieTarget, specifier: "%.0f")").font(.title3).bold().foregroundColor(.primary) }
                        }.padding(.top, 25).padding(.horizontal, 20)

                        ZStack {
                            Circle().stroke(Color.primary.opacity(0.05), lineWidth: 35).padding(18)
                            Circle().stroke(themeManager.currentTheme == .classicWhite ? Color.cyan.opacity(0.8) : Color(red: 0.2, green: 0.6, blue: 1.0).opacity(0.4), lineWidth: 35).padding(18)
                            Circle().trim(from: 0.0, to: min(1.0, CGFloat(monthlyCaloriesConsumed / max(1, monthlyCalorieTarget))))
                                .stroke(themeManager.currentTheme == .classicWhite ? Color.yellow : Color(red: 1.0, green: 0.82, blue: 0.4), style: StrokeStyle(lineWidth: 35, lineCap: themeManager.currentTheme == .muzliDark ? .round : .butt)).rotationEffect(.degrees(-90)).padding(18)

                            VStack(spacing: 2) {
                                if themeManager.currentTheme == .classicWhite {
                                    Image(systemName: "flame.fill").foregroundColor(.orange).font(.title)
                                    if netCalorieBalance <= 0 { Text("Deficit").font(.caption).foregroundColor(.primary); Text("\(abs(netCalorieBalance), specifier: "%.0f") kcal").font(.title3).bold().foregroundColor(.green) }
                                    else { Text("Surplus").font(.caption).foregroundColor(.primary); Text("+\(netCalorieBalance, specifier: "%.0f") kcal").font(.title3).bold().foregroundColor(.red) }
                                } else {
                                    Text("\(Int(min(100.0, (monthlyCaloriesConsumed / max(1, monthlyCalorieTarget)) * 100)))%").font(.system(size: 38, weight: .bold)).foregroundColor(.white)
