// MARK: - 2. HEALTH MANAGER (Logic Layer)
class HealthManager: ObservableObject {
    @Published var isAuthorized = false
    @Published var isMissingVitalData = false
    @Published var profile = UserProfile()
    @Published var workoutLogs: [WorkoutLog] = []
    @Published var notifications: [AppNotification] = []

    @Published var customCategories: [CategoryItem] = [
        CategoryItem(name: "Breakfast", emoji: "🍞"),
        CategoryItem(name: "Lunch", emoji: "🥗"),
        CategoryItem(name: "Dinner", emoji: "🥩"),
        CategoryItem(name: "Snack", emoji: "🍪"),
        CategoryItem(name: "Supplements", emoji: "🥤")
    ]

    func requestAuthorization() {
        DispatchQueue.main.asyncAfter(deadline: .now() + 1.0) {
            self.isAuthorized = true
            self.fetchHealthData()
        }
    }

    func fetchHealthData() {
        self.workoutLogs = [
            WorkoutLog(date: Date(), workoutType: "Outdoor Run", caloriesBurned: 450.0)
        ]
        if self.profile.weightKg == nil || self.profile.heightCm == nil {
            withAnimation(.spring()) { self.isMissingVitalData = true }
        }
    }

    func generateLocalWeeklyReport(from allLogs: [MealLog]) {
        let calendar = Calendar.current
        let today = Date()
        guard let startOfWeek = calendar.date(from: calendar.dateComponents([.yearForWeekOfYear, .weekOfYear], from: today)),
              let endOfWeek = calendar.date(byAdding: .day, value: 7, to: startOfWeek) else { return }

        let weeklyLogs = allLogs.filter { $0.date >= startOfWeek && $0.date < endOfWeek && ($0.isSavedTemplate == false || $0.isSavedTemplate == nil) }

        let totalCals = weeklyLogs.reduce(0) { $0 + $1.calories }
        let targetCals = profile.baseDailyTargetCalories * 7
        let difference = targetCals - totalCals
        let status = difference < 0 ? "a surplus of \(Int(abs(difference))) kcal" : "a healthy deficit of \(Int(abs(difference))) kcal"

        var categoryCounts: [String: Int] = [:]
        for log in weeklyLogs { categoryCounts[log.categoryItem.name, default: 0] += 1 }
        let topCategory = categoryCounts.max(by: { $0.value < $1.value })?.key ?? "None"

        let reportText = """
        Your weekly check-in is here! Over the past 7 days, you consumed \(Int(totalCals)) kcal out of your \(Int(targetCals)) kcal target, placing you in \(status).

        Your most frequently logged meal time was \(topCategory). To optimize your results next week, ensure you are tracking your exact protein intake and water consumption. Keep up the great consistency!
        """

        let newNotif = AppNotification(icon: "chart.bar.doc.horizontal", colorR: 0.0, colorG: 0.8, colorB: 0.6, title: "Weekly Data Report", text: reportText, date: Date())
        DispatchQueue.main.async {
            withAnimation { self.notifications.insert(newNotif, at: 0) }
        }
    }

    func fetchMealEstimate(name: String, weight: Double, cuisine: String) async -> Double {
        try? await Task.sleep(nanoseconds: 1_000_000_000)
        return weight * 2.4
    }

    func validateMacros(protein: Double, carbs: Double, fiber: Double, fat: Double) async -> Double {
        try? await Task.sleep(nanoseconds: 1_000_000_000)
        return (protein * 4.0) + (max(0, carbs - fiber) * 4.0) + (fat * 9.0)
    }
}

