struct CalendarOverviewView: View {
    @Environment(\.dismiss) var dismiss
    @EnvironmentObject var themeManager: ThemeManager
    @Binding var mealLogs: [MealLog]
    @State var viewingDate: Date
    let daysOfWeek = ["S", "M", "T", "W", "T", "F", "S"]
    let columns = Array(repeating: GridItem(.flexible()), count: 7)
    var body: some View {
        NavigationView {
            ZStack {
                ThemeBackgroundView()
                VStack {
                    HStack { Button(action: { changeMonth(by: -1) }) { Image(systemName: "chevron.left").font(.title2).foregroundColor(.primary) }; Spacer(); Text(formatMonthYear(viewingDate)).font(.title2).bold().foregroundColor(.primary); Spacer(); Button(action: { changeMonth(by: 1) }) { Image(systemName: "chevron.right").font(.title2).foregroundColor(.primary) } }.padding()
                    HStack { ForEach(daysOfWeek, id: \.self) { day in Text(day).font(.caption).bold().foregroundColor(.secondary).frame(maxWidth: .infinity) } }.padding(.horizontal)
                    LazyVGrid(columns: columns, spacing: 15) {
                        ForEach(generateDaysInMonth(), id: \.self) { date in
                            if let date = date {
                                let hasLog = mealLogs.contains { Calendar.current.isDate($0.date, inSameDayAs: date) }
                                let isToday = Calendar.current.isDateInToday(date)
                                VStack(spacing: 4) {
                                    Text("\(Calendar.current.component(.day, from: date))").font(.headline).foregroundColor(isToday ? (themeManager.currentTheme == .muzliDark ? Color(red: 0.12, green: 0.16, blue: 0.20) : .white) : .primary).frame(width: 35, height: 35).background(isToday ? (themeManager.currentTheme == .muzliDark ? Color(red: 0.02, green: 0.84, blue: 0.63) : .red) : Color.clear).clipShape(Circle())
                                    Circle().fill(hasLog ? .orange : Color.clear).frame(width: 6, height: 6)
                                }
                            } else { Color.clear.frame(width: 35, height: 35) }
                        }
                    }.padding(); Spacer()
                }
            }.navigationBarTitleDisplayMode(.inline).toolbar { ToolbarItem(placement: .navigationBarTrailing) { Button("Done") { dismiss() }.foregroundColor(.primary) } }
        }
    }
    func formatMonthYear(_ date: Date) -> String { let f = DateFormatter(); f.dateFormat = "MMMM yyyy"; return f.string(from: date) }
    func changeMonth(by value: Int) { if let newDate = Calendar.current.date(byAdding: .month, value: value, to: viewingDate) { viewingDate = newDate } }
    func generateDaysInMonth() -> [Date?] {
        let calendar = Calendar.current, components = calendar.dateComponents([.year, .month], from: viewingDate)
        guard let startOfMonth = calendar.date(from: components), let range = calendar.range(of: .day, in: .month, for: startOfMonth) else { return [] }
        let firstWeekday = calendar.component(.weekday, from: startOfMonth)
        var days: [Date?] = Array(repeating: nil, count: firstWeekday - 1)
        for day in range { if let date = calendar.date(byAdding: .day, value: day - 1, to: startOfMonth) { days.append(date) } }
        return days
    }
}

struct IntakeDetailView: View {
    @Environment(\.dismiss) var dismiss
    @EnvironmentObject var themeManager: ThemeManager
    let validMonthLogs: [MealLog]
    @State private var selectedCategory: CategoryItem?

    var categoryBreakdown: [(categoryItem: CategoryItem, calories: Double, percentage: Double)] {
        let total = validMonthLogs.reduce(0) { $0 + $1.calories }, grouped = Dictionary(grouping: validMonthLogs) { $0.categoryItem }
        return grouped.map { (key, logs) in let catTotal = logs.reduce(0) { $0 + $1.calories }, percent = total > 0 ? (catTotal / total) * 100 : 0; return (categoryItem: key, calories: catTotal, percentage: percent) }.sorted { $0.calories > $1.calories }
    }
    var dailyTotals: [(date: Date, calories: Double)] { return Dictionary(grouping: validMonthLogs) { Calendar.current.startOfDay(for: $0.date) }.map { (date: $0.key, calories: $0.value.reduce(0) { $0 + $1.calories }) }.sorted { $0.date < $1.date } }

    var body: some View {
        NavigationView {
            ZStack {
                ThemeBackgroundView()
                VStack {
                    TabView {
                        VStack {
                            Text("Calorie Distribution").font(.headline).foregroundColor(.secondary)
                            if categoryBreakdown.isEmpty { Text("No data").foregroundColor(.secondary).padding() }
                            else { Chart { ForEach(categoryBreakdown, id: \.categoryItem.name) { item in SectorMark(angle: .value("Calories", item.calories), innerRadius: .ratio(0.55), angularInset: 1.5).foregroundStyle(Color.blue).annotation(position: .overlay) { Text("\(item.percentage, specifier: "%.0f")%").font(.caption).bold().foregroundColor(.white) } } }.padding() }
                        }.padding().themeGlassStyle().padding()
                        VStack {
                            Text("Daily Intake Trend").font(.headline).foregroundColor(.secondary)
                            if dailyTotals.isEmpty { Text("No data").foregroundColor(.secondary).padding() }
                            else { Chart { ForEach(dailyTotals, id: \.date) { item in PointMark(x: .value("Date", item.date), y: .value("Calories", item.calories)).foregroundStyle(themeManager.currentTheme == .classicWhite ? Color.blue : Color(red: 1.0, green: 0.82, blue: 0.4)).symbolSize(100); LineMark(x: .value("Date", item.date), y: .value("Calories", item.calories)).foregroundStyle(themeManager.currentTheme == .classicWhite ? Color.blue.opacity(0.3) : Color(red: 1.0, green: 0.82, blue: 0.4).opacity(0.3)) } }.chartXAxis { AxisMarks(values: .stride(by: .day)) { _ in AxisGridLine(); AxisValueLabel(format: .dateTime.day()).foregroundStyle(Color.secondary) } }.chartYAxis { AxisMarks() { _ in AxisGridLine(); AxisValueLabel().foregroundStyle(Color.secondary) } }.padding() }
                        }.padding().themeGlassStyle().padding()
                    }.tabViewStyle(PageTabViewStyle(indexDisplayMode: .always)).frame(height: 300).padding(.bottom, 10)
                    List {
                        Section(header: Text("Tap a category").foregroundColor(.secondary)) {
                            ForEach(categoryBreakdown, id: \.categoryItem.name) { item in Button(action: { selectedCategory = item.categoryItem }) { HStack { Text(item.categoryItem.emoji).font(.title2); Text(item.categoryItem.name).font(.body).foregroundColor(.primary); Spacer(); VStack(alignment: .trailing) { Text("\(item.calories, specifier: "%.0f") kcal").bold().foregroundColor(.primary); Text("\(item.percentage, specifier: "%.1f")%").font(.caption).foregroundColor(.secondary) }; Image(systemName: "chevron.right").foregroundColor(.secondary).font(.caption) } } }
                        }.listRowBackground(Color.primary.opacity(0.05))
                    }.listStyle(.insetGrouped).scrollContentBackground(.hidden)
                }
            }.navigationTitle("Intake Breakdown").navigationBarTitleDisplayMode(.inline).toolbar { ToolbarItem(placement: .navigationBarTrailing) { Button("Close") { dismiss() }.foregroundColor(.primary) } }.sheet(item: $selectedCategory) { category in CategoryDetailView(categoryItem: category, logs: validMonthLogs.filter { $0.categoryItem.name == category.name }.sorted { $0.date > $1.date }) }
        }
    }
}

